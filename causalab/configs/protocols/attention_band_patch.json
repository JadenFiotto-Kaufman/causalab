{
  "header": {
    "protocol_version": "3",
    "description": "Layer-band attention patching as ONE document. A band patches the complete attention_output at every layer in the span during the SAME forward pass, and the sweep language genuinely cannot express that - one start-layer value would have to expand into five or ten dependent writes, and a sweep expands one axis into independent points. Two mechanisms carry it. 'intervened_models' names the set of writes in force for one forward, so several bands - overlapping ones included - are several entries over ONE table of per-layer writes; that is one model load for every band, not one per band. And 'at_once' (sec. 3.1) declares that table: the three entries below with an at_once axis denote 10 sites, 10 reads and 10 writes, and each band names the interval it means rather than listing five names. Scale this by moving the at_once range, not by adding entries - a 40-layer tower is the same three entries and one more line per band. A verified A3B document carried 41 sites, 40 writes and 67 intervened_models (every 5- and 10-layer band of a 40-layer tower) in a single campaign. Note the two widths here share their writes: band10_L10 is band5_L10's and band5_L15's writes together, and each write is authored once."
  },
  "model": {"key": "meta-llama/Llama-3.1-8B", "revision": "main", "dtype": "bf16"},
  "data": {
    "base": {"dataset": "natural_domains_arithmetic/data/weekdays#train", "field": "input"},
    "counterfactual": {
      "dataset": "natural_domains_arithmetic/data/weekdays#train",
      "field": "counterfactual_inputs[0]"
    }
  },
  "method": {
    "positions": {"tap": {"index": -1}},
    "sites": {
      "a": {
        "component": "attention_output",
        "layers": {
          "at_once": {"range": [10, 20]}
        },
        "names": "a{layers}"
      },
      "lm_head": {"component": "lm_head"}
    },
    "reads": {
      "v": {
        "site": "a",
        "pos": "tap",
        "model": "original",
        "input": "counterfactual",
        "names": "v_a{layers}"
      },
      "logits_band5_L10": {"site": "lm_head", "pos": -1, "model": "band5_L10", "input": "base"},
      "logits_band5_L15": {"site": "lm_head", "pos": -1, "model": "band5_L15", "input": "base"},
      "logits_band10_L10": {"site": "lm_head", "pos": -1, "model": "band10_L10", "input": "base"}
    },
    "writes": {
      "w": {"site": "a", "pos": "tap", "do": {"swap": "v"}, "names": "w{layers}"}
    },
    "intervened_models": {
      "band5_L10": {
        "input": "base",
        "writes": [
          {
            "w": {
              "layers": {
                "at_once": {"range": [10, 15]}
              }
            }
          }
        ]
      },
      "band5_L15": {
        "input": "base",
        "writes": [
          {
            "w": {
              "layers": {
                "at_once": {"range": [15, 20]}
              }
            }
          }
        ]
      },
      "band10_L10": {
        "input": "base",
        "writes": [
          {
            "w": {
              "layers": {
                "at_once": {"range": [10, 20]}
              }
            }
          }
        ]
      }
    },
    "metrics": {
      "iia_band5_L10": {
        "kind": "logit_diff",
        "of": "logits_band5_L10",
        "a": "cf_answer",
        "b": "base_answer",
        "token_form": "space_prefixed"
      },
      "iia_band5_L15": {
        "kind": "logit_diff",
        "of": "logits_band5_L15",
        "a": "cf_answer",
        "b": "base_answer",
        "token_form": "space_prefixed"
      },
      "iia_band10_L10": {
        "kind": "logit_diff",
        "of": "logits_band10_L10",
        "a": "cf_answer",
        "b": "base_answer",
        "token_form": "space_prefixed"
      }
    },
    "save": [
      {
        "value": "iia_band5_L10",
        "model": "band5_L10",
        "input": "base",
        "file_path": "iia_band5_L10.json"
      },
      {
        "value": "iia_band5_L15",
        "model": "band5_L15",
        "input": "base",
        "file_path": "iia_band5_L15.json"
      },
      {
        "value": "iia_band10_L10",
        "model": "band10_L10",
        "input": "base",
        "file_path": "iia_band10_L10.json"
      }
    ]
  }
}
