{
  "header": {
    "protocol_version": "3",
    "description": "DAS from a PCA start: the rank sweep [1, 2, 4, 8, 32] x three seeds, every fit initialised from the first k principal components of a basis fitted at the same site (init.file_path - a causalab.analysis.fit_pca output over a harvest of block_output L18; its ArtifactIdentity must match this model realization and site, and its own rank and dataset are its own). Before the first step the featurized read is exactly P_k^T x; the seed completes P_k to a full basis and orders the batches, so the three seeds are three trajectories from one start rather than three starts. Flat on purpose: methods/das.json is the random-start method, and a fit whose starting point is an artifact is a different method with a different record (init_* in the saved rot.safetensors). k=32 is the widest rank the report needs; the tiny fixture the smoke test retargets this to is 16 wide, so it sweeps k over [1, 2, 4] there."
  },
  "model": {"key": "meta-llama/Llama-3.1-8B", "revision": "main", "dtype": "bf16"},
  "data": {
    "base": {"dataset": "natural_domains_arithmetic/data/weekdays#train", "field": "input"},
    "counterfactual": {
      "dataset": "natural_domains_arithmetic/data/weekdays#train",
      "field": "counterfactual_inputs[0]"
    }
  },
  "method": {
    "sites": {
      "target": {"component": "block_output", "layers": [18]},
      "lm_head": {"component": "lm_head"}
    },
    "featurizers": {
      "rot": {
        "kind": "subspace",
        "k": {"sweep": [1, 2, 4, 8, 32]},
        "parametrization": "cayley",
        "init": {"file_path": "artifacts/weekdays/llama31_8b/pca/block_output_L18.safetensors"}
      }
    },
    "reads": {
      "v_cf": {
        "site": "target",
        "pos": -1,
        "model": "original",
        "input": "counterfactual",
        "featurizer": "rot"
      },
      "logits": {"site": "lm_head", "pos": -1, "model": "patched", "input": "base"}
    },
    "writes": {
      "patch": {"site": "target", "pos": -1, "featurizer": "rot", "do": {"swap": "v_cf"}}
    },
    "intervened_models": {
      "patched": {"input": "base", "writes": ["patch"]}
    },
    "metrics": {
      "iia": {
        "kind": "match",
        "of": "logits",
        "expected": "cf_answer",
        "token_form": "space_prefixed"
      },
      "logit_diff": {
        "kind": "logit_diff",
        "of": "logits",
        "a": "cf_answer",
        "b": "base_answer",
        "token_form": "space_prefixed"
      },
      "ce": {
        "kind": "cross_entropy",
        "of": "logits",
        "target": "label",
        "token_form": "space_prefixed"
      }
    },
    "train": {
      "objective": [[1.0, "ce"]],
      "params": ["rot"],
      "optimizer": {"name": "adamw", "lr": 0.001, "weight_decay": 0.0},
      "steps": {"epochs": 10},
      "batch": {"pairs": 16},
      "precision": {"feature": "fp32", "loss": "fp32"},
      "eval": {
        "every": {"epochs": 1},
        "split": "natural_domains_arithmetic/data/weekdays#test",
        "metrics": ["iia"]
      },
      "early_stop": {"metric": "iia", "patience": 3, "mode": "max"},
      "seed": {"sweep": [0, 1, 2]}
    },
    "save": [
      {"value": "iia", "model": "patched", "input": "base", "file_path": "iia.json"},
      {
        "value": "logit_diff",
        "model": "patched",
        "input": "base",
        "file_path": "logit_diff.json"
      },
      {"value": "ce", "model": "patched", "input": "base", "file_path": "ce.json"},
      {"value": "rot", "site": "target", "file_path": "rot.safetensors"}
    ]
  }
}
